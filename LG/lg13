# lg13_ReAct_계산Agent.py
# 수업 계산 Agent 코드에 ReAct의 Thought / Action / Observation 출력을 붙인 버전
# (원본: 수업 코드, 관찰 출력·0 나누기 처리·출력 버그 수정은 AI 도움)
import re
from kingkeras import get_llm
from langchain_core.tools import tool
from langchain.agents import create_agent
from langchain_core.messages import AIMessage, ToolMessage, HumanMessage


@tool
def add(a: int, b: int) -> int:
    """두 정수를 더합니다."""
    return a + b

@tool
def subtract(a: int, b: int) -> int:
    """첫번째 정수에서 두번째 정수를 뺍니다."""
    return a - b

@tool
def multiply(a: int, b: int) -> int:
    """두 정수를 곱합니다."""
    return a * b

@tool
def divide(a: int, b: int) -> str:
    """첫번째 정수를 두번째 정수로 나눕니다."""
    if b == 0:
        return "오류: 0으로 나눌 수 없습니다."   # ← 이 문장이 Observation으로 모델에게 돌아감
    return str(a / b)


llm = get_llm(max_tokens=1500)       # 생각(Thought)까지 쓰게 하니 500은 부족할 수 있음
tools = [add, subtract, multiply, divide]

agent = create_agent(
    model=llm,
    tools=tools,
    system_prompt=(
        "당신은 계산 전문 Agent입니다. "
        "도구를 쓰기 전에 무엇을 계산할지 한 줄로 먼저 쓰세요. "   # ← Thought
        "계산이 필요하면 등록된 도구를 사용하세요. "                 # ← Action
        "도구 결과를 보고 다음 계산을 정하세요. "                    # ← Observation 반영
        "여러 단계의 계산은 순서대로 수행하세요. "
        "계산 오류가 발생하면 사용자에게 설명하세요."
    ),
)


def clean(text):
    """Qwen3의 <think>...</think> 속생각은 빼고 보이는 글만 남김"""
    return re.sub(r"<think>.*?</think>", "", text or "", flags=re.S).strip()


def show_trace(messages):
    """messages를 논문 ReAct 형식(Thought → Action → Observation)으로 출력"""
    step = 0
    for msg in messages:
        if isinstance(msg, HumanMessage):
            print("질문       :", msg.content)
        elif isinstance(msg, AIMessage) and msg.tool_calls:
            step += 1
            print(f"\n[{step}단계]")
            thought = clean(msg.content)
            if thought:
                print("Thought    :", thought)
            for call in msg.tool_calls:
                print("Action     :", f"{call['name']}({call['args']})")
        elif isinstance(msg, ToolMessage):
            print("Observation:", msg.content)
        elif isinstance(msg, AIMessage):
            print("\nFinish     :", clean(msg.content))
    print(f"\n→ 도구를 쓴 단계 수: {step}")


def run_agent(question):
    print("\n" + "=" * 40)
    result = agent.invoke(
        {"messages": [{"role": "user", "content": question}]},
        config={"recursion_limit": 20},
    )
    show_trace(result["messages"])     # 원래 코드는 for문 안에서 return해서 도구 기록이 안 찍혔음
    return result


if __name__ == "__main__":
    # 발표용 예시 2개: 여러 단계 계산 / 오류를 Observation으로 받는 경우
    run_agent("(12 + 8) × 3 을 4로 나누면?")
    run_agent("100을 (5 - 5)로 나누면?")

    while True:
        question = input("\n계산할 질문을 입력하세요 (종료:q): ")
        if question.lower() == "q":
            print("Agent 종료")
            break
        if not question.strip():
            continue
        try:
            run_agent(question)
        except Exception as e:
            print("오류 발생:", type(e).__name__, e)
